{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arigami",
  "version": "0.1.0",
  "identifier": "io.arigami.desktop",
  "build": {
    "frontendDist": "splash-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arigami",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources-staged": "resources-staged"
    }
  }
}
