#!/usr/bin/env bash
# host — lifecycle CLI for arigami: start|stop|restart|status|logs [-f]|doctor|pair|user|profile|ext|export|import
# Pidfile + logs under $ARIGAMI_DIR (default ~/.arigami); health check = GET /__api/config.
set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DIR="${ARIGAMI_DIR:-$HOME/.arigami}"
LOGDIR="$DIR/logs"
PIDFILE="$DIR/host.pid"
LOG="$LOGDIR/host.log"
ERRLOG="$LOGDIR/host.err.log"
CONFIG="$DIR/config.json"

# port: ARIGAMI_PORT env > config.json > default (3099; a non-default
# ARIGAMI_DIR defaults to 4099 — the server shifts every range by +1000, T5)
PORT=3099
[ "$DIR" != "$HOME/.arigami" ] && PORT=4099
if [ -f "$CONFIG" ]; then
  p="$(sed -n 's/.*"port"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$CONFIG" | head -1)"
  [ -n "$p" ] && PORT="$p"
fi
[ -n "${ARIGAMI_PORT:-}" ] && PORT="$ARIGAMI_PORT"
URL="http://127.0.0.1:$PORT"

# Dedicated Chrome profile for the cockpit window: a clean app-mode window,
# isolated from your everyday Chrome, with its own persistent cockpit sign-in.
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
CHROME_PROFILE="$DIR/chrome-profile"

g() { printf '\033[32m%s\033[0m' "$1"; }
r() { printf '\033[31m%s\033[0m' "$1"; }
y() { printf '\033[33m%s\033[0m' "$1"; }
d() { printf '\033[2m%s\033[0m' "$1"; }
# newline-terminated variants for standalone lines (keeps shellcheck SC2005 happy)
gl() { printf '\033[32m%s\033[0m\n' "$1"; }
rl() { printf '\033[31m%s\033[0m\n' "$1"; }
yl() { printf '\033[33m%s\033[0m\n' "$1"; }
dl() { printf '\033[2m%s\033[0m\n' "$1"; }

read_pid() { cat "$PIDFILE" 2>/dev/null || true; }
alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
health() { curl -fsS -m 2 "$URL/__api/config" >/dev/null 2>&1; }

PLIST_LABEL="io.arigami.host"
PLIST="$HOME/Library/LaunchAgents/$PLIST_LABEL.plist"
launchd_loaded() { launchctl list 2>/dev/null | grep -q "$PLIST_LABEL"; }

# ---- systemd (Linux) --------------------------------------------------------
# Units live in the repo (deploy/systemd/); `install` renders them with this
# checkout's paths and enables them. Once installed, start/stop/restart/status
# defer to systemctl so KeepAlive-style respawn and our pidfile never fight.
UNIT_NAME="arigami"
UNIT_SRC="$ROOT/deploy/systemd/arigami.service"
UNIT_DST="/etc/systemd/system/$UNIT_NAME.service"
BUN_DIR="$(dirname "$(command -v bun 2>/dev/null || echo /usr/local/bin/bun)")"
have_systemd() { [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; }
systemd_managed() { have_systemd && systemctl cat "$UNIT_NAME" >/dev/null 2>&1; }
as_root() {
  if [ "$(id -u)" = "0" ]; then "$@"
  elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then sudo "$@"
  else return 126; fi
}

# F8: a fresh host (no admin yet) prints its one-time pairing code right after
# "host started" — the user should never have to dig through logs for it.
pairing_hint() {
  [ -f "$DIR/run/pairing-code" ] || return 0
  echo "  pairing code: $(y "$(cat "$DIR/run/pairing-code")")   (enter it once in the cockpit → creates the admin)"
}
render_unit() { # render_unit <src> — substitutes the __TOKENS__ for this checkout
  sed -e "s#__ROOT__#$ROOT#g" -e "s#__USER__#$(id -un)#g" -e "s#__HOME__#$HOME#g" -e "s#__BUN_DIR__#$BUN_DIR#g" "$1"
}
# The claude CLI the host resolves (mirrors server/claude.js): an explicit
# ARIGAMI_CLAUDE_BIN — from the env, $DIR/env (systemd EnvironmentFile) or
# $DIR/secrets.env — wins; otherwise `claude` on PATH.
claude_bin() {
  b="${ARIGAMI_CLAUDE_BIN:-}"
  for f in "$DIR/env" "$DIR/secrets.env" "$ROOT/.local.env"; do
    [ -n "$b" ] && break
    [ -f "$f" ] || continue
    b="$(sed -n 's/^[[:space:]]*ARIGAMI_CLAUDE_BIN[[:space:]]*=[[:space:]]*//p' "$f" | tail -1 | sed 's/^["'"'"']//; s/["'"'"']$//')"
  done
  if [ -z "$b" ]; then b="$(command -v claude 2>/dev/null || true)"; fi
  printf '%s' "$b"
}
manager_name() {
  if systemd_managed; then echo systemd
  elif [ -f "$PLIST" ]; then echo launchd
  elif command -v pm2 >/dev/null 2>&1 && pm2 jlist 2>/dev/null | grep -q '"name":"arigami"'; then echo pm2
  else echo none; fi
}

start() {
  pid="$(read_pid)"
  if alive "$pid" && health; then
    echo "$(y "already running") (pid $pid) on :$PORT"
    return 0
  fi
  if systemd_managed; then
    as_root systemctl start "$UNIT_NAME" || { rl "systemctl start failed (need root/sudo?)"; return 1; }
    i=0
    while [ "$i" -lt 60 ]; do
      if health; then echo "$(g "✓ host started") (systemd) → $URL"; pairing_hint; return 0; fi
      sleep 0.25; i=$((i + 1))
    done
    echo "$(r "unit started but health check failed") — see: journalctl -u $UNIT_NAME"
    return 1
  fi
  # launchd-managed install: load the agent instead of forking our own process,
  # otherwise KeepAlive and the pidfile copy would fight over the port.
  if [ -f "$PLIST" ]; then
    launchctl load "$PLIST" 2>/dev/null || true
    i=0
    while [ "$i" -lt 40 ]; do
      if health; then echo "$(g "✓ host started") (launchd) → $URL"; pairing_hint; return 0; fi
      sleep 0.15; i=$((i + 1))
    done
    echo "$(r "launchd agent loaded but health check failed") — see: host logs"
    return 1
  fi
  mkdir -p "$LOGDIR" "$DIR"
  nohup bun "$ROOT/server/index.ts" >>"$LOG" 2>>"$ERRLOG" </dev/null &
  pid=$!
  echo "$pid" >"$PIDFILE"
  i=0
  while [ "$i" -lt 40 ]; do
    if health; then
      echo "$(g "✓ host started") (pid $pid) → $URL"
      pairing_hint
      return 0
    fi
    if ! alive "$pid"; then
      echo "$(r "✗ process died on startup") — see: host logs"
      return 1
    fi
    sleep 0.15
    i=$((i + 1))
  done
  echo "$(r "started (pid $pid) but health check failed") — see: host logs"
  return 1
}

stop_pid() {
  alive "$1" || return 1
  kill "$1" 2>/dev/null
  i=0
  while [ "$i" -lt 30 ]; do
    alive "$1" || return 0
    sleep 0.1
    i=$((i + 1))
  done
  kill -9 "$1" 2>/dev/null
  return 0
}

# Kill anything the server recorded as a child and then outlived (server/lib/
# children.ts owns the records and the pid-reuse guard — call into it rather than
# reimplementing that check in shell). The server runs the same sweep at startup.
sweep_children() {
  [ -f "$DIR/children.json" ] || return 0
  command -v bun >/dev/null 2>&1 || return 0
  n="$(bun -e "const m = await import('$ROOT/server/lib/children.ts'); console.log(m.sweepOrphans())" 2>/dev/null | tail -1)"
  case "$n" in
    ''|0) : ;;
    *) dl "  swept $n orphaned child process tree(s)" ;;
  esac
  return 0
}

stop() {
  if systemd_managed; then
    as_root systemctl stop "$UNIT_NAME" || { rl "systemctl stop failed (need root/sudo?)"; return 1; }
    sweep_children
    gl "✓ stopped (systemd)"
    return 0
  fi
  # Unload the launchd agent first or KeepAlive instantly respawns what we kill.
  if launchd_loaded; then
    launchctl unload "$PLIST" 2>/dev/null || true
    echo "$(g "✓ launchd agent unloaded") $(d "(host install re-enables autostart)")"
  fi
  pid="$(read_pid)"
  if stop_pid "$pid"; then
    rm -f "$PIDFILE"
    # kill -TERM reaches the claude procs, not the tree under them; sweep the rest.
    sweep_children
    echo "$(g "✓ stopped") (pid $pid)"
    return 0
  fi
  # fallback: whatever listens on the port
  pids="$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null || true)"
  if [ -n "$pids" ]; then
    for p in $pids; do stop_pid "$p"; done
    rm -f "$PIDFILE"
    sweep_children
    echo "$(g "✓ stopped") (port :$PORT, pid $pids)"
    return 0
  fi
  sweep_children
  yl "not running"
}

status() {
  pid="$(read_pid)"
  # launchd-managed instances have no pidfile — resolve by port.
  [ -z "$pid" ] && pid="$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1)"
  if health; then
    sessions="$(curl -fsS -m 2 "$URL/__api/sessions" 2>/dev/null | grep -o '"id":"sess_' | wc -l | tr -d ' ')"
    mgr="$(manager_name)"; [ "$mgr" = none ] && mgr="" || mgr=" ($mgr)"
    echo "$(g "● running")  pid ${pid:-?}$mgr  :$PORT  sessions: ${sessions:-?}"
  elif alive "$pid"; then
    echo "$(y "◍ process alive but not responding") (pid $pid) — check: host logs"
  else
    rl "○ not running"
  fi
}

logs() {
  if [ ! -f "$LOG" ]; then
    dl "(no log yet)"
    return 0
  fi
  if [ "${1:-}" = "-f" ] || [ "${1:-}" = "--follow" ]; then
    exec tail -n 100 -F "$LOG" "$ERRLOG"
  fi
  tail -n 200 "$LOG"
}

doctor() {
  printf '\033[1mhost doctor\033[0m\n\n'
  if [ -f "$CONFIG" ]; then echo "config: $CONFIG $(g "✓")"; else echo "config: $CONFIG $(y "(defaults)")"; fi
  echo "port: $PORT"
  echo
  dl "tooling:"
  for bin in bun curl; do
    if command -v "$bin" >/dev/null 2>&1; then
      v="$("$bin" --version 2>/dev/null | head -1)"
      echo "  $bin: $(g "${v:-found}")"
    else
      echo "  $bin: $(r "not found")"
    fi
  done
  # claude: the binary the HOST actually runs (F3 #6) — ARIGAMI_CLAUDE_BIN from
  # the environment or from $DIR/env (the unit's EnvironmentFile) / secrets.env
  # — not whatever `claude` happens to be first on this shell's PATH.
  cbin="$(claude_bin)"
  if [ -n "$cbin" ] && [ -x "$cbin" ] || command -v "$cbin" >/dev/null 2>&1; then
    v="$("$cbin" --version 2>/dev/null | head -1)"
    echo "  claude: $(g "${v:-found}") $(d "($cbin)")"
  elif [ -n "$cbin" ]; then
    echo "  claude: $(r "ARIGAMI_CLAUDE_BIN=$cbin is not executable")"
  else
    echo "  claude: $(r "not found") — set ARIGAMI_CLAUDE_BIN in $DIR/env or add it to PATH"
  fi
  echo
  dl "files:"
  [ -d "$ROOT/node_modules" ] && echo "  node_modules: $(g "✓")" || echo "  node_modules: $(r "✗ — run: bun install")"
  [ -f "$ROOT/web/dist/index.html" ] && echo "  web/dist: $(g "✓")" || echo "  web/dist: $(y "missing — run: bun run build:web")"
  [ -f "$ROOT/server/lib/config.ts" ] && echo "  server/lib/config.ts: $(g "✓")" || echo "  server/lib/config.ts: $(y "missing (stub fallback in use)")"
  echo
  dl "auth (C1):"
  bind="$(sed -n 's/.*"bind"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG" 2>/dev/null | head -1)"
  mode="$(sed -n 's/.*"mode"[[:space:]]*:[[:space:]]*"\(pairing\|oidc\|off\)".*/\1/p' "$CONFIG" 2>/dev/null | head -1)"
  echo "  bind: ${ARIGAMI_BIND:-${bind:-127.0.0.1 (default)}}"
  echo "  mode: ${ARIGAMI_AUTH:-${mode:-pairing (default)}}"
  if [ -f "$DIR/users.json" ]; then echo "  users.json: $(g "✓")"; else echo "  users.json: $(y "none — run: host pair, then enter the code at /__host/")"; fi
  [ -f "$DIR/run/pairing-code" ] && echo "  pairing code pending: $(y "$(cat "$DIR/run/pairing-code")")"
  [ -f "$DIR/pending-profile" ] && echo "  profile pending: $(y "$(cat "$DIR/pending-profile")") $(d "(host profile apply pending)")"
  echo
  # B3 — the SAME state machine the cockpit wizard and the funnel read
  # (server/onboarding.ts wizard()); computed in-process, no host needed.
  dl "onboarding (B3 wizard):"
  if command -v bun >/dev/null 2>&1; then
    ARIGAMI_DIR="$DIR" ARIGAMI_PORT="$PORT" bun "$ROOT/server/onboarding.ts" doctor 2>/dev/null || yl "  (could not compute — run: bun install)"
  else
    yl "  (bun not found)"
  fi
  echo
  # S1 — the capability registry (server/capabilities.ts): the SAME list the
  # in-chat Setup card and Settings → Connections read. Offline probes only.
  dl "capabilities (S1 registry):"
  if command -v bun >/dev/null 2>&1; then
    ARIGAMI_DIR="$DIR" ARIGAMI_PORT="$PORT" bun "$ROOT/server/capabilities.ts" doctor 2>/dev/null || yl "  (could not compute — run: bun install)"
  else
    yl "  (bun not found)"
  fi
  echo
  dl "runtime:"
  echo "  manager: $(manager_name)"
  if systemd_managed; then
    echo "  unit: $UNIT_NAME.service $(systemctl is-enabled "$UNIT_NAME" 2>/dev/null || echo '?') / $(systemctl is-active "$UNIT_NAME" 2>/dev/null || echo '?')"
  fi
  if have_systemd && [ ! -f "$UNIT_DST" ] && [ "$(uname -s)" = Linux ]; then
    echo "  $(y "not installed as a systemd unit") — run: bin/host install"
  fi
  printf '  '
  status
  if health; then
    printf '  '
    curl -fsS -m 2 "$URL/__api/version" 2>/dev/null | sed -n 's/.*"version":"\([^"]*\)".*"commit":"\([^"]*\)".*/version: \1 (\2)/p'
  fi
}

install_systemd() {
  [ -f "$UNIT_SRC" ] || { rl "missing $UNIT_SRC"; return 1; }
  tmp="$(mktemp)"
  render_unit "$UNIT_SRC" >"$tmp"
  if ! as_root install -m 0644 "$tmp" "$UNIT_DST"; then
    rm -f "$tmp"
    yl "no root/sudo — install the unit by hand:"
    echo "  $ROOT/bin/host render-unit | sudo tee $UNIT_DST"
    echo "  sudo systemctl daemon-reload && sudo systemctl enable --now $UNIT_NAME"
    dl "  (docs/DEPLOY.md has the full pm2 → systemd migration)"
    return 1
  fi
  rm -f "$tmp"
  # Hand over from a pidfile-managed process cleanly (the unit owns the port now).
  pid="$(read_pid)"
  if alive "$pid"; then stop_pid "$pid"; rm -f "$PIDFILE"; fi
  as_root systemctl daemon-reload
  as_root systemctl enable --now "$UNIT_NAME" || { rl "systemctl enable --now failed — see: journalctl -u $UNIT_NAME"; return 1; }
  gl "✓ installed systemd unit $UNIT_DST (host :$PORT)"
  dl "  restarts on crash and on POST /__api/host/restart; logs: journalctl -u $UNIT_NAME -f"
}

uninstall_systemd() {
  as_root systemctl disable --now "$UNIT_NAME" 2>/dev/null || true
  as_root rm -f "$UNIT_DST" && as_root systemctl daemon-reload
  gl "✓ removed systemd unit $UNIT_NAME"
}

# C1 — pairing + users. Delegates to server/auth.ts (same ARIGAMI_DIR rules as
# the server) so the code file lands exactly where the running host reads it.
pair() { ARIGAMI_DIR="$DIR" bun "$ROOT/server/auth.ts" pair; }
user() { ARIGAMI_DIR="$DIR" bun "$ROOT/server/auth.ts" user "$@"; }

# K3 — profile bundles (server/profiles.ts). `apply` cannot authenticate against
# a RUNNING host (the host bearer is in-memory, C1) unless the caller exports an
# admin API token as ARIGAMI_TOKEN — then it goes through REST. Otherwise:
# host down → apply in-process; host up → stage as $ARIGAMI_DIR/pending-profile
# for the wizard (B3) / Setup to finish.
profile() {
  sub="${1:-}"; shift || true
  case "$sub" in
    list) ARIGAMI_DIR="$DIR" bun "$ROOT/server/profiles.ts" list ;;
    current) ARIGAMI_DIR="$DIR" bun "$ROOT/server/profiles.ts" current ;;
    validate) ARIGAMI_DIR="$DIR" bun "$ROOT/server/profiles.ts" validate "${1:?usage: host profile validate <src>}" ;;
    apply|install)
      src="${1:?usage: host profile apply <name|dir|git-url> [--force]}"
      force=false; case " ${*:2} " in *" --force "*) force=true ;; esac   # A4: overwrite existing agents shipped by the bundle
      if health && [ -n "${ARIGAMI_TOKEN:-}" ]; then
        curl -fsS -m 300 -X POST "$URL/__api/profiles/apply" \
          -H "Authorization: Bearer $ARIGAMI_TOKEN" -H 'content-type: application/json' \
          --data "$(printf '{"source":"%s","force":%s}' "$(printf '%s' "$src" | sed 's/["\\]/\\&/g')" "$force")"
        echo
      elif health; then
        ARIGAMI_DIR="$DIR" bun "$ROOT/server/profiles.ts" pending "$src" || return 1
        yl "host is running and no ARIGAMI_TOKEN is set — staged as pending"
        dl "  finish it in the cockpit (Setup → Profile) or: ARIGAMI_TOKEN=<admin api token> host profile apply $src"
      else
        ARIGAMI_DIR="$DIR" bun "$ROOT/server/profiles.ts" apply "$src" $([ "$force" = true ] && echo --force)
      fi
      ;;
    *) echo "usage: host profile <list|current|validate <src>|apply <name|dir|git-url> [--force]>"; return 1 ;;
  esac
}

# EXT — extensions (server/extensions.ts). Same shape as `profile`: when the
# host is up and an admin ARIGAMI_TOKEN is exported the commands go through
# REST (so the LIVE process reloads); with the host down they run in-process
# against $ARIGAMI_DIR. `add` prints the manifest's permissions first —
# extension code runs with the host's privileges, so installing one is a
# decision, not a detail.
ext_api() { # method path [json-body]
  if [ -n "${3:-}" ]; then
    curl -fsS -m 300 -X "$1" "$URL$2" -H "Authorization: Bearer ${ARIGAMI_TOKEN:-}" -H 'content-type: application/json' --data "$3"
  else
    curl -fsS -m 300 -X "$1" "$URL$2" -H "Authorization: Bearer ${ARIGAMI_TOKEN:-}"
  fi
}
ext_json() { printf '{"source":"%s"}' "$(printf '%s' "$1" | sed 's/["\\]/\\&/g')"; }
ext_live() { health && [ -n "${ARIGAMI_TOKEN:-}" ]; }

ext() {
  sub="${1:-list}"; shift || true
  case "$sub" in
    list)
      if ext_live; then ext_api GET /__api/extensions; echo
      else ARIGAMI_DIR="$DIR" bun "$ROOT/server/extensions.ts" list; fi ;;
    validate)
      src="${1:?usage: host ext validate <dir>}"
      if ext_live; then ext_api POST /__api/extensions/validate "$(ext_json "$src")"; echo
      else ARIGAMI_DIR="$DIR" bun "$ROOT/server/extensions.ts" validate "$src"; fi ;;
    add|install)
      src="${1:?usage: host ext add <dir|git-url>}"
      if ext_live; then ext_api POST /__api/extensions/add "$(ext_json "$src")"; echo
      else ARIGAMI_DIR="$DIR" bun "$ROOT/server/extensions.ts" add "$src"; fi ;;
    remove|rm)
      name="${1:?usage: host ext remove <name>}"
      if ext_live; then ext_api DELETE "/__api/extensions/$name"; echo
      else ARIGAMI_DIR="$DIR" bun "$ROOT/server/extensions.ts" remove "$name"; fi ;;
    update)
      if ext_live; then ext_api POST "/__api/extensions/${1:?usage: host ext update <name>}/update" '{}'; echo
      else ARIGAMI_DIR="$DIR" bun "$ROOT/server/extensions.ts" update "${1:-}"; fi ;;
    reload)
      if ext_live; then ext_api POST /__api/extensions/reload '{}'; echo
      else ARIGAMI_DIR="$DIR" bun "$ROOT/server/extensions.ts" reload; fi ;;
    enable|disable)
      name="${1:?usage: host ext $sub <name>}"
      want=$([ "$sub" = enable ] && echo true || echo false)
      if ext_live; then ext_api PATCH "/__api/extensions/$name" "{\"enabled\":$want}"; echo
      else ARIGAMI_DIR="$DIR" bun "$ROOT/server/extensions.ts" "$sub" "$name"; fi ;;
    *)
      echo "usage: host ext <list|validate <dir>|add <dir|git-url>|remove <name>|update <name>|reload|enable <name>|disable <name>>"
      dl "  with the host UP, export ARIGAMI_TOKEN=<admin api token> so the change reaches the running process"
      return 1 ;;
  esac
}

# B4-full — export / import (server/backup.ts). Both run in-process against
# $ARIGAMI_DIR; reading is always safe. A FULL import swaps $ARIGAMI_DIR under
# the host, so with the host up it goes through REST (needs ARIGAMI_TOKEN =
# admin API token; the host restarts itself afterwards) or is refused —
# `host stop` first, import, `host start`. Bundle import = profile apply.
export_cmd() {
  mode=""; out=""; extra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --full|--bundle) mode="$1" ;;
      --include|--name) extra+=("$1" "$2"); shift ;;
      --no-memory) extra+=("$1") ;;
      *) out="$1" ;;
    esac
    shift
  done
  case "$mode" in
    --full)
      out="${out:-arigami-backup-$(date -u +%Y%m%dT%H%M%SZ).tgz}"
      if health; then yl "host is running — the snapshot is taken live (state.json may lag a few seconds; stop the host for a perfectly quiet copy)"; fi
      ARIGAMI_DIR="$DIR" bun "$ROOT/server/backup.ts" export --full "$out" "${extra[@]}" || return 1
      dl "  contains accounts + secrets as they are on disk — keep it private. Restore: host import $out"
      ;;
    --bundle)
      out="${out:-arigami-bundle-$(date -u +%Y%m%dT%H%M%SZ)}"
      # backup.ts reports memoryWarning:true (and prints its own stderr warning) when USER.md/MEMORY.md went in
      res="$(ARIGAMI_DIR="$DIR" bun "$ROOT/server/backup.ts" export --bundle "$out" "${extra[@]}")" || return 1
      printf '%s\n' "$res"
      dl "  no secrets/accounts/chat inside. Apply elsewhere: host profile apply <dir>  (or host import <file.tgz>)"
      if printf '%s' "$res" | grep -q '"memoryWarning": true'; then
        yl "  memory-seed/ carries your USER.md / MEMORY.md (personal profile + notes) — review before sharing, or: host export --bundle --no-memory"
      fi
      ;;
    *) echo "usage: host export --full [out.tgz] [--include a,b] | host export --bundle [out-dir|out.tgz] [--name name] [--no-memory]"; return 1 ;;
  esac
}

import_cmd() {
  file=""; force=""
  while [ $# -gt 0 ]; do
    case "$1" in --force) force="--force" ;; *) file="$1" ;; esac
    shift
  done
  [ -n "$file" ] && [ -f "$file" ] || { echo "usage: host import <file.tgz> [--force]"; return 1; }
  kind="$(ARIGAMI_DIR="$DIR" bun "$ROOT/server/backup.ts" inspect "$file" 2>/dev/null | sed -n 's/^[[:space:]]*"kind":[[:space:]]*"\([a-z]*\)".*/\1/p' | head -1)"
  [ -n "$kind" ] || { ARIGAMI_DIR="$DIR" bun "$ROOT/server/backup.ts" inspect "$file"; return 1; }
  if [ "$kind" = "bundle" ]; then
    if health; then
      dl "profile bundle → staging + apply through the host"
      tmpd="$(mktemp -d)"; tar -xzf "$file" -C "$tmpd" || return 1
      profile apply "$tmpd"; rc=$?; rm -rf "$tmpd"; return $rc
    fi
    ARIGAMI_DIR="$DIR" bun "$ROOT/server/backup.ts" import "$file"
    return $?
  fi
  # full backup
  if health; then
    if [ -n "${ARIGAMI_TOKEN:-}" ]; then
      q=""; [ -n "$force" ] && q="?force=1"
      curl -fsS -m 3600 -X POST "$URL/__api/host/import$q" \
        -H "Authorization: Bearer $ARIGAMI_TOKEN" -H 'X-Arigami-Confirm: yes' \
        -H 'content-type: application/gzip' --data-binary "@$file" || return 1
      echo
      dl "  with a supervisor the host restarts itself; the reply says restart.scheduled:false otherwise — then: host restart"
      return 0
    fi
    rl "host is running: a full restore replaces $DIR under it."
    dl "  either:  host stop && host import $file && host start"
    dl "  or:      ARIGAMI_TOKEN=<admin api token> host import $file   (REST; the host restarts itself)"
    return 1
  fi
  ARIGAMI_DIR="$DIR" bun "$ROOT/server/backup.ts" import "$file" $force || return 1
  dl "  previous data kept as a timestamped .bak next to $DIR — start the host: host start"
}

install() {
  bun_bin="$(command -v bun)"
  if [ -z "$bun_bin" ]; then rl "bun not found on PATH"; return 1; fi
  if [ "$(uname -s)" = Linux ]; then
    if have_systemd; then install_systemd; return $?; fi
    rl "no systemd on this Linux — run the host under your own supervisor (docs/DEPLOY.md)"; return 1
  fi
  mkdir -p "$HOME/Library/LaunchAgents" "$LOGDIR"
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$PLIST_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$bun_bin</string>
    <string>$ROOT/server/index.ts</string>
  </array>
  <key>WorkingDirectory</key><string>$ROOT</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>${PATH:-/usr/local/bin:/usr/bin:/bin}</string>
    <key>HOME</key><string>$HOME</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$ERRLOG</string>
</dict>
</plist>
EOF
  # Hand over from a pidfile-managed process to launchd cleanly.
  pid="$(read_pid)"
  if alive "$pid"; then stop_pid "$pid"; rm -f "$PIDFILE"; fi
  launchctl unload "$PLIST" 2>/dev/null || true
  launchctl load "$PLIST"
  gl "✓ installed launchd agent $PLIST_LABEL (host :$PORT)"

  dl "  auto-starts on login + respawns on crash. The Arigami.app just opens the window."
}

uninstall() {
  if [ "$(uname -s)" = Linux ]; then uninstall_systemd; return $?; fi
  for p in "$PLIST"; do
    launchctl unload "$p" 2>/dev/null || true
    [ -f "$p" ] && rm -f "$p"
  done
  gl "✓ removed launchd agent"
}

# One-click: bring up the host, then open the cockpit in a Chrome app window.
launch() {
  start || return 1
  if [ ! -x "$CHROME" ]; then rl "Google Chrome not found at $CHROME"; return 1; fi
  mkdir -p "$CHROME_PROFILE"
  # A force-killed/crashed Chrome leaves Singleton* locks that block the next
  # launch with this profile. Clear them when nothing is using the profile.
  if ! pgrep -f "user-data-dir=$CHROME_PROFILE" >/dev/null 2>&1; then
    rm -f "$CHROME_PROFILE/SingletonLock" "$CHROME_PROFILE/SingletonCookie" "$CHROME_PROFILE/SingletonSocket" 2>/dev/null || true
  fi
  dl "opening cockpit in Chrome…"
  # Dedicated profile + --app = a standalone app window (no tabs/omnibox), its own
  # persistent cockpit sign-in, isolated from your everyday Chrome. `open -na` launches
  # a NEW Chrome instance fully DETACHED from this launcher (so it survives the
  # .app process exiting, when run from Finder) and brings it to the front.
  open -na "Google Chrome" --args \
    --user-data-dir="$CHROME_PROFILE" --app="$URL/__host/" \
    --no-first-run --no-default-browser-check
  echo "$(g "✓ Arigami open") → $URL/__host/"
}

case "${1:-status}" in
  start) start ;;
  launch|app) launch ;;
  stop) stop ;;
  restart)
    if systemd_managed; then
      as_root systemctl restart "$UNIT_NAME" || { rl "systemctl restart failed (need root/sudo?)"; exit 1; }
      i=0; while [ "$i" -lt 60 ]; do health && { echo "$(g "✓ restarted") (systemd) → $URL"; exit 0; }; sleep 0.25; i=$((i+1)); done
      rl "restarted but health check failed — see: journalctl -u $UNIT_NAME"; exit 1
    fi
    stop
    sleep 0.4
    start
    ;;
  render-unit) render_unit "${UNIT_SRC}" ;;
  status) status ;;
  logs) shift; logs "${1:-}" ;;
  doctor) doctor ;;
  pair) pair ;;
  user) shift; user "$@" ;;
  profile) shift; profile "$@" ;;
  ext) shift; ext "$@" ;;
  export) shift; export_cmd "$@" ;;
  import) shift; import_cmd "$@" ;;
  install) install ;;
  uninstall) uninstall ;;
  *)
    echo "usage: host <launch|start|stop|restart|status|logs [-f]|doctor|pair|user list|user remove <id|email>|profile list|apply <src>|ext list|add <src>|remove <name>|export --full|--bundle [out] [--no-memory]|import <file.tgz>|install|uninstall|render-unit>"
    exit 1
    ;;
esac
