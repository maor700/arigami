# Arigami — environment template.
# Copy to repo-root `.env` (bun auto-loads it when the server starts):
#     cp .env.example .env
# Everything here is OPTIONAL for a basic local run — the host works with the
# `claude` CLI's own keychain login and the built-in defaults. Fill in only
# what you need. NEVER commit the real `.env` (already gitignored).

# --- Claude account ----------------------------------------------------------
# Run the host on a SPECIFIC Claude account instead of the machine's `claude`
# keychain login (e.g. a work Team seat while your terminal uses a personal
# Max). Mint one with `claude setup-token` while logged into that account.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-XXXXXXXXXXXXXXXXXXXXXXXX

# API-key billing instead of a subscription (unattended automation). If set it
# OVERRIDES the subscription — leave commented for normal use, not just empty.
# ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXX

# --- Integrations ------------------------------------------------------------
# Voice control (Hebrew STT + command routing via Groq). Without it the mic
# button shows an error toast; everything else works.
# GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXX

# Linear ticket pages (/__ticket/<id>) without the per-user OAuth connect —
# needed mainly for autonomous triggers. Personal API key from
# linear.app → Settings → API.
# LINEAR_API_KEY=lin_api_XXXXXXXXXXXXXXXXXXXXXXXX

# GitHub token for git/gh inside sessions. Usually unnecessary — `gh auth
# login` on the machine covers it (and is what the git-auth onboarding gate
# checks).
# GH_TOKEN=gho_XXXXXXXXXXXXXXXXXXXXXXXX

# --- Host paths & identity (defaults are fine on a dev Mac) --------------------
# ARIGAMI_PORT=3099
# ARIGAMI_DIR=~/.arigami             # config/state/registry root
# ARIGAMI_REPOS_DIR=~/Desktop/repos    # where onboarding clones managed repos
# ARIGAMI_DEFAULT_CWD=~/Desktop/repos  # cwd for new empty sessions
# ARIGAMI_PROD_URL=https://your-app.example.com   # optional: prod URL for the compare view
# ARIGAMI_LINEAR_WORKSPACE=your-workspace          # optional: Linear workspace slug

# --- Deployment-only (see docs/DOCKER.md) --------------------------------------
# Encrypts stored account tokens at rest (K8s Secret).
# ARIGAMI_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Screen share (shared host desktop over the in-process /__vnc bridge).
# All optional; also editable in ~/.arigami/config.json under "screen".
# ARIGAMI_SCREEN_ENABLED=1
# ARIGAMI_VNC_HOST=127.0.0.1
# ARIGAMI_VNC_PORT=5900
# ARIGAMI_VNC_PASSWORD=   # VNC-auth password (UI: Settings → Screen share)
# Screenshots in the chat (capture_screen tool + Watch-mode auto-snapshots).
# ARIGAMI_SCREEN_DISPLAY=:99            # X display for the scrot/import fallback (defaults to $DISPLAY)
# ARIGAMI_AUTO_SNAPSHOTS=0              # record the desktop while a request_screen card is in Watch (off by default)
# ARIGAMI_SNAPSHOT_INTERVAL_MS=10000    # …how often to look at the screen when on
# ARIGAMI_SNAPSHOT_MIN_INTERVAL_MS=30000 # …never record two frames closer than this
# ARIGAMI_SNAPSHOT_CHANGE_THRESHOLD=0.03 # …and only if >3% of sampled pixels changed
# ARIGAMI_SCREENSHOT_RETENTION_DAYS=7   # delete ~/.arigami/uploads/screens/* older than this
# ARIGAMI_SCREENSHOT_MAX_MB=200         # …or oldest-first once the folder exceeds this
