# Copy to repo-root .env  (cp docker/.env.example .env)  and fill in.
# In K8s these become a Secret mounted as env. Nothing here is required to
# boot: an empty .env still starts the host and prints a pairing code.

# --- image tag (ghcr.io/maor700/arigami:<tag>) — latest, X.Y.Z or sha-<7> ---
# ARIGAMI_TAG=latest

# --- Claude Code auth — pick ONE (see docs/DOCKER.md § Claude auth) ---
# (A) Subscription (Max/Pro) — long-lived OAuth token, made ONCE on a laptop:
#       claude setup-token
#     and pasted here. The official headless path; valid ~1 year.
# CLAUDE_CODE_OAUTH_TOKEN=
# (B) Subscription via the cockpit: leave both unset, open Setup → Claude →
#     "Connect" — the host runs the PKCE flow, you approve in your browser and
#     paste the code back. Token lands on the /data volume and auto-refreshes.
# (C) API key (usage-billed, best for unattended automation). If set, it
#     OVERRIDES the subscription — so for (A)/(B) it must stay commented, not
#     just empty (an empty value still shadows the subscription token).
# ANTHROPIC_API_KEY=

# --- git/gh auth for private repos (fine-grained PAT, repo scope) ---
GH_TOKEN=
GIT_NAME=Arigami
GIT_EMAIL=arigami@example.com

# --- integrations (all optional) ---
# COMPOSIO_API_KEY=
# voice control (STT + router via Groq)
GROQ_API_KEY=

# --- desktop / browser (image defaults shown; override only if needed) ---
# The host starts Xvfb :99 + openbox + x11vnc (127.0.0.1:5900) itself on boot.
# ARIGAMI_GLOBAL_DESKTOP=0        # don't start the shared desktop (image sets 1)
# ARIGAMI_SCREEN_ENABLED=0        # disable screen-share entirely
# ARIGAMI_VNC_PASSWORD=           # x11vnc password (loopback-only anyway)
# CHROME_BIN=/usr/local/bin/arigami-chrome   # google-chrome (amd64) / chromium (arm64)

# --- WhatsApp bridge (image defaults) ---
# ARIGAMI_WA_MCP_DIR=/opt/whatsapp-mcp
# ARIGAMI_WA_DATA_DIR=/data/.arigami/whatsapp/data

# --- TLS edge (docker compose --profile tls up) — see docs/TLS.md ---
# Public hostname whose DNS points at this machine (ports 80+443 open). Caddy
# gets a Let's Encrypt certificate for it and proxies to the arigami container.
# ARIGAMI_DOMAIN=arigami.example.com
# The host must know its browser-facing origin: OAuth/OIDC redirects, share
# links and the `Secure` cookie flag all derive from it. Same name as above.
# ARIGAMI_PUBLIC_URL=https://arigami.example.com
# Rate limits need the caddy-ratelimit build (default). With stock caddy:
# ARIGAMI_RATELIMIT_FILE=ratelimit-off.caddy
