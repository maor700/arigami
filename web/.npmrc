# The web UI uses the FREE FontAwesome packages (@fortawesome/free-solid-svg-icons,
# fontawesome-svg-core), which live on the public npm registry and need NO token.
# Pin the whole @fortawesome scope to public npm so an ambient/global .npmrc that
# points @fortawesome at a private registry can't hijack the install —
# without a token for it that redirect 401s and leaves the package unresolved
# (fontawesome-svg-core/styles.css "can't resolve" at build time).
# Project-level .npmrc wins over global.
@fortawesome:registry=https://registry.npmjs.org/
